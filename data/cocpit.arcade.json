                "id": "arc_sp1_bias",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/bullet-8226.svg",
                "text": "While the Opponent is on top of the <span style=\"color: #fcba03\">Booby Trap</span>, they are 60% more likely to launch a Special Attack."
            },
            {
                "id": "arc_trapbot_tv_stun",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/s-115.svg",
                "text": "If the Opponent is not performing a Special Attack and they are on top of the <span style=\"color: #fcba03\">Booby Trap</span>, charging or releasing Arcade's Heavy Attack causes it to explode and Passively Stuns the Opponent for 3 seconds."
            },
            {
                "id": "arc_trapbot_tv_stun_rfrsh_pool",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/bullet-8226.svg",
                "text": "While the Opponent is inside of a <span style=\"color: #00cc6d\">Poisonous Cloud</span> and they are Stunned by this explosion, the existing <span style=\"color: #00cc6d\">Poisonous Cloud</span> will be refreshed instead of deploying a new one."
            },
            {
                "id": "arc_trapbot_tv_cd_fst",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/bullet-8226.svg",
                "text": "After exploding, the <span style=\"color: #fcba03\">Booby Trap</span> goes on standby for 20 seconds, or 10 seconds as a Defender. As an Attacker, this expires 15% faster per unique personal Damaging Debuff on the Opponent."
            }
