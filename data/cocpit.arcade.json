    "sigAbilityDisplayName": "WELCOME TO MURDERWORLD!",
    "sigAbilities": {
        "Passive": [
            {
                "id": "arc_sig_5s_steadfast",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/S-83.svg",
                "text": "Just before Arcade Auto-Blocks an attack, gain a non-stacking <span class=\"tooltip\">Steadfast<span class=\"tooltiptext\"><img src=\"https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/S-83.svg\" class=\"tooltip-icon\"><span class=\"tooltip-title\">Steadfast</span><br>While active, Unblockable Attacks can be blocked as though they weren't</span></span> Buff for <span style=\"color: #16982bff\">3.61</span> seconds, paused during the Opponent's Special Attacks. This will not trigger if the attack is a Heavy Attack, or if the Opponent has an Undermine effect."
            },
            {
                "id": "arc_sig_5s_torment",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/uniE742-59202.svg",
                "text": "When the Opponent enters a <span style=\"color: #00cc6d\">Poisonous Cloud</span>, inflict a <span style=\"color: #16982bff\">7.01%</span> <span class=\"tooltip\">Torment<span class=\"tooltiptext\"><img src=\"https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/uniE742-59202.svg\" class=\"tooltip-icon\"><span class=\"tooltip-title\">Torment</span><br>Increases the duration of all incoming Damaging Debuffs.</span></span> Debuff for 8 seconds. This starts paused, and is unpaused when the Opponent exits the <span style=\"color: #00cc6d\">Poisonous Cloud</span>. Max stacks: 3."
            }
        ]
    },
    "coreAbilities": {
        "Persistent Prize Tickets - Max: 5": [
            {
                "id": "arc_init_pv_tix",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/bullet-8226.svg",
                "text": "Arcade starts each Quest with 3 <span style=\"color: #37bfff\">Persistent Prize Tickets</span>. When winning a fight as an Attacker, convert 50% of all <span style=\"color: #d4d121\">Arcade Tokens</span> into <span style=\"color: #37bfff\">Persistent Prize Tickets</span> (rounded down). If a fight is won with fewer than 2 <span style=\"color: #d4d121\">Arcade Tokens</span>, gain 1 <span style=\"color: #37bfff\">Persistent Prize Ticket</span> anyways."
            },
            {
                "id": "arc_set_pv_tix_tokens",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/bullet-8226.svg",
                "text": "<span style=\"color: #37bfff\">Persistent Prize Tickets</span> can be spent in the Pre-Fight Screen to activate a <span style=\"color: #bc22c6\">Fabulous Prize</span>. <span style=\"color: #bc22c6\">Fabulous Prizes</span> can only be used by Arcade, and last until his Opponent is defeated. These are always active as a Defender."
            }
        ],
        "Pre-Fight Ability - Fabulous Prizes": [
            {
                "id": "arc_fab_pwrup_aa",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/bullet-8226.svg",
                "text": "<span style=\"color: #bc22c6\">Power-Up:</span> Personal effects and the Stun from the Parry Mastery gain +100% Ability Accuracy. If Arcade is not fighting a Cosmic Champion, he also gains Incinerate Immunity. Costs 1 <span style=\"color: #37bfff\">Persistent Prize Ticket</span>."
            },
            {
                "id": "arc_fab_chtcd_co",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/bullet-8226.svg",
                "text": "<span style=\"color: #bc22c6\">Cheat Code:</span> The Opponent's True Strike, True Accuracy, and True Sense effects suffer -100% Ability Accuracy. If Arcade is not fighting a Cosmic Champion, he also gains Poison Immunity. Costs 2 <span style=\"color: #37bfff\">Persistent Prize Tickets</span>."
            },
            {
                "id": "arc_fab_gmwzrd_co",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/bullet-8226.svg",
                "text": "<span style=\"color: #bc22c6\">Game Wizard:</span> The duration of personal Damaging Debuffs cannot be reduced. If Arcade is not fighting a Cosmic Champion, he also gains Shock Immunity. Costs 3 <span style=\"color: #37bfff\">Persistent Prize Tickets</span>."
            }
        ],
        "Always Active": [
            {
                "id": "arc_aa_ctech_fry",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/bullet-8226.svg",
                "text": "Arcade does not benefit from the Collar Tech Mastery. Instead, he gains <span style=\"color: #16982bff\">+159.54</span> Attack Rating for each rank invested and reduces the Opponent's Defensive Combat Power Rate by 7% for each unique personal Damaging Debuff on them."
            },
            {
                "id": "arc_aa_l4_sp3_lock",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/bullet-8226.svg",
                "text": "As an Attacker, Arcade's fourth Light Attack disables his Special Attack 3 for 0.50 seconds."
            }
        ],
        "Arcade Tokens - Max: 10": [
            {
                "id": "arc_tokens",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/uniE914-59668.svg",
                "text": "Whenever the Opponent would be Poisoned, Arcade gains 1 <span style=\"color: #d4d121\">Arcade Token</span>. As a Defender, he gains 1 additional <span style=\"color: #d4d121\">Arcade Token</span> if a Poison is not prevented by Immunity, and gains 3 on the final hit of Special Attack 2 on hit, Block or <span class=\"tooltip\">Dodge<span class=\"tooltiptext\"><span class=\"tooltip-title\">Dodge</span><br>Dodge back to avoid an incoming Basic Attack or contact Special Attack hit. The Dexterity Mastery increases the window for a successful Dodge and allows you to avoid non-contact Special Attacks.</span></span>."
            },
            {
                "id": "arc_token_rmv",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/bullet-8226.svg",
                "text": "Each <span style=\"color: #d4d121\">Arcade Token</span> increases Armor Rating and the potency of personal Damaging Debuffs by 10%. When knocked down, lose 2 <span style=\"color: #d4d121\">Arcade Tokens</span>."
            },
            {
                "id": "arc_token_ab_passive",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/X-88.svg",
                "text": "While Arcade has 10 <span style=\"color: #d4d121\">Arcade Tokens</span>, or 3 or more as a Defender, he gains an indefinite Auto-Block Passive granting a 100% chance to Auto-Block incoming attacks. Arcade cannot Auto-Block the Opponent's Heavy Attacks."
            },
            {
                "id": "arc_token_ab_charge",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/X-88.svg",
                "text": "With 2 or more <span style=\"color: #d4d121\">Arcade Tokens</span>, Arcade also has a 100% chance to Auto-Block attacks while charging or releasing his own Heavy Attack."
            },
            {
                "id": "arc_ab_shock",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/O-79.svg",
                "text": "When Auto-Blocking an attack, inflict a <span class=\"tooltip\">Shock<span class=\"tooltiptext\"><img src=\"https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/O-79.svg\" class=\"tooltip-icon\"><span class=\"tooltip-title\">Shock</span><br>Deals Energy Damage while active.</span></span> Debuff dealing <span style=\"color: #16982bff\">6381.6</span> Energy Damage over 3 seconds, trigger the <span class=\"tooltip\">Parry<span class=\"tooltiptext\"><img src=\"https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/greater-62.svg\" class=\"tooltip-icon\"><span class=\"tooltip-title\">Parry</span><br>Performing a Well-Timed Block activates the Parry Mastery, increasing Block Proficiency and Stunning the Opponent for a period of time.</span></span> Mastery if it is active, and consume 8 <span style=\"color: #d4d121\">Arcade Tokens</span>, or 3 as a Defender."
            }
        ],
        "Trap - Poisonous Cloud": [
            {
                "id": "arc_trappool_rmv",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/z-122.svg",
                "text": "After the second hit of his Heavy Attack, Arcade deploys a <span style=\"color: #00cc6d\">Poisonous Cloud</span>. <span style=\"color: #00cc6d\">Poisonous Clouds</span> last for 10 seconds, and active <span style=\"color: #00cc6d\">Poisonous Clouds</span> are removed when deploying a new one."
            },
            {
                "id": "arc_trappool_tv_poison",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/z-122.svg",
                "text": "When the Opponent enters a <span style=\"color: #00cc6d\">Poisonous Cloud</span>, gain 1 <span style=\"color: #d4d121\">Arcade Token</span>. Each second the Opponent is inside the <span style=\"color: #00cc6d\">Poisonous Cloud</span>, they are inflicted with a <span class=\"tooltip\">Poison<span class=\"tooltiptext\"><img src=\"https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/z-122.svg\" class=\"tooltip-icon\"><span class=\"tooltip-title\">Poison</span><br>While active, deals Direct Damage and reduces Regeneration Rate by 30% of its current value.</span></span> Debuff dealing <span style=\"color: #16982bff\">3722.6</span> Direct Damage over 10 seconds."
            }
        ],
        "Trap - Booby Trap": [
            {
                "id": "arc_trapbot_tv_start",
                "iconFilename": "https://cocpit-cdn.nyc3.cdn.digitaloceanspaces.com/2026.09.09/glyphs/s-115.svg",
                "text": "At the start of each fight, a <span style=\"color: #fcba03\">Booby Trap</span> is placed in the Defender's corner. The <span style=\"color: #fcba03\">Booby Trap</span> will not be placed if the Opponent is also Arcade."
